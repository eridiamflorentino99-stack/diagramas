@startuml Modulo3_Ventas

left to right direction

actor Vendedor

rectangle "Módulo 3: Ventas" {

    usecase "Registrar venta" as UC1
    usecase "Buscar producto" as UC2
    usecase "Consultar disponibilidad" as UC3
    usecase "Agregar producto a venta" as UC4
    usecase "Calcular subtotal" as UC5
    usecase "Aplicar descuento" as UC6
    usecase "Calcular total" as UC7
    usecase "Registrar forma de pago" as UC8
    usecase "Generar ticket" as UC9
    usecase "Cancelar venta" as UC10
}
Vendedor --> UC1
Vendedor --> UC10
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC7 : <<include>>
UC1 ..> UC8 : <<include>>
UC1 ..> UC9 : <<include>>
UC4 ..> UC2 : <<include>>
UC4 ..> UC3 : <<include>>
UC7 ..> UC5 : <<include>>
UC6 ..> UC7 : <<extend>>

@enduml